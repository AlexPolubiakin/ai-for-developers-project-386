generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule   ScheduleInterval[]
  eventTypes EventType[]
  bookings   Booking[]
}

model ScheduleInterval {
  id        String @id @default(uuid())
  ownerId   String
  dayOfWeek Int
  startTime String
  endTime   String

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, dayOfWeek, startTime, endTime])
  @@index([ownerId])
}

model EventType {
  id              String   @id @default(uuid())
  ownerId         String
  title           String
  description     String?
  durationMinutes Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner    Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([ownerId])
}

enum BookingStatus {
  confirmed
  cancelled
}

model Booking {
  id           String        @id @default(uuid())
  eventTypeId  String
  ownerId      String
  startTime    DateTime
  endTime      DateTime
  guestName    String
  guestEmail   String
  status       BookingStatus @default(confirmed)
  createdAt    DateTime      @default(now())

  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@unique([ownerId, startTime])
  @@index([ownerId, startTime])
  @@index([eventTypeId])
}
